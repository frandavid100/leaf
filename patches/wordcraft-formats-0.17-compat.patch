+/// Preserve editable section links and dormant parts beside ODF's independent master pages.
+fn page_links(doc: &Document, pages: &mut Vec<(String, SectionProps)>) -> Vec<(u8, u8)> {
+    // ODF master pages stand alone; copy inherited content but retain editable links.
+    let mut links = Vec::with_capacity(pages.len());
+    let mut previous = SectionProps::default();
+    for (index, (_, sec)) in pages.iter_mut().enumerate() {
+        let mask = |set: wordcraft_doc::section::HeaderSet| {
+            if index == 0 {
+                0
+            } else {
+                u8::from(set.default.is_none())
+                    | (u8::from(set.even.is_none()) << 1)
+                    | (u8::from(set.first.is_none()) << 2)
+            }
+        };
+        links.push((mask(sec.headers), mask(sec.footers)));
+        for (set, inherited) in [
+            (&mut sec.headers, previous.headers),
+            (&mut sec.footers, previous.footers),
+        ] {
+            set.default = set.default.or(inherited.default);
+            set.even = set.even.or(inherited.even);
+            set.first = set.first.or(inherited.first);
+        }
+        previous = sec.clone();
+    }
+    // Unreferenced page parts remain recoverable without activating them in the body.
+    let used: std::collections::HashSet<_> = pages
+        .iter()
+        .flat_map(|(_, sec)| {
+            [
+                sec.headers.default,
+                sec.headers.even,
+                sec.headers.first,
+                sec.footers.default,
+                sec.footers.even,
+                sec.footers.first,
+            ]
+            .into_iter()
+            .flatten()
+        })
+        .collect();
+    for (id, part) in &doc.parts {
+        if used.contains(id)
+            || !matches!(
+                part.kind,
+                wordcraft_doc::PartKind::Header | wordcraft_doc::PartKind::Footer
+            )
+        {
+            continue;
+        }
+        let mut sec = SectionProps::default();
+        if part.kind == wordcraft_doc::PartKind::Header {
+            sec.headers.default = Some(*id);
+        } else {
+            sec.footers.default = Some(*id);
+        }
+        let mut name = format!("LeafUnused{id}");
+        while pages.iter().any(|(existing, _)| existing == &name) {
+            name.push('_');
+        }
+        pages.push((name, sec));
+        links.push((0, 0));
+    }
+    links
+}
