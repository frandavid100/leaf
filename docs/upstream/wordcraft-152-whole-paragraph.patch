+
+/// Whole preceding paragraphs, including their marks, do not donate formatting (Leaf #152).
+#[test]
+fn delete_whole_preceding_paragraph_keeps_following_formatting() {
+    for reverse in [false, true] {
+        for count in [1, 2] {
+            let mut d = Document::from_text(if count == 1 { "Heading\nFollowing" } else { "Heading\nSecond heading\nFollowing" });
+            d.para_mut(StoryRef::Body, &Path::top(0)).unwrap().props.style = Some("Heading2".into());
+            let following = Pos::body(count, 0);
+            let p = d.para_mut(StoryRef::Body, &following.path).unwrap();
+            p.props.style = Some("ListParagraph".into());
+            p.props.align = Some(crate::props::Align::Right);
+            p.mark.bold = Some(false);
+            p.mark.italic = Some(true);
+            let expected = p.clone();
+            let start = Pos::body(0, 0);
+            let (a, b) = if reverse { (&following, &start) } else { (&start, &following) };
+            d.delete_range(a, b).unwrap();
+            let actual = d.para_at(&Pos::body(0, 0)).unwrap();
+            assert_eq!(actual.text, expected.text);
+            assert_eq!(actual.props, expected.props);
+            assert_eq!(actual.mark, expected.mark);
+            assert_eq!(actual.runs, expected.runs);
+            assert_eq!(actual.objects, expected.objects);
+        }
+    }
+}
+
+/// A range that retains leading text or deletes part of the tail remains a merge.
+#[test]
+fn partial_paragraph_deletion_keeps_the_leading_paragraph_style() {
+    for (from, to) in [(1, 0), (0, 1)] {
+        let mut d = Document::from_text("Heading\nFollowing");
+        d.para_mut(StoryRef::Body, &Path::top(0)).unwrap().props.style = Some("Heading2".into());
+        d.delete_range(&Pos::body(0, from), &Pos::body(1, to)).unwrap();
+        assert_eq!(d.para_at(&Pos::body(0, 0)).unwrap().props.style.as_deref(), Some("Heading2"));
+    }
+}
