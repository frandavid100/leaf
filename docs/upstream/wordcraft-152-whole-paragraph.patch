+
+/// Leaf #152: the whole non-empty heading, unlike a partial merge, must not restyle its successor.
+#[test]
+fn whole_heading_delete_preserves_list_formatting_history_and_docx() {
+    for command in ["text.delete", "text.backspace"] {
+        for backwards in [false, true] {
+            let mut s = fixture();
+            run(&mut s, "text.insert", json!({"text":"Heading"}));
+            s.sel = Selection::caret(Pos::body(1, 0));
+            run(&mut s, "para.bullets", json!({}));
+            let expected = s.doc.para_at(&Pos::body(1, 0)).unwrap().clone();
+            let before = s.doc.clone();
+            let (a, b) = (Pos::body(0, 0), Pos::body(1, 0));
+            s.sel = if backwards { Selection { anchor: b, focus: a } } else { Selection { anchor: a, focus: b } };
+            run(&mut s, command, json!({}));
+            let p = s.doc.para_at(&Pos::body(0, 0)).unwrap();
+            assert_eq!(p.text, expected.text);
+            assert_eq!(p.props, expected.props);
+            assert_eq!(p.mark, expected.mark);
+            assert_eq!(p.runs, expected.runs);
+            assert_eq!(outline::levels(&s.doc)[..2], [outline::BODY, 2]);
+            let after = s.doc.clone();
+            run(&mut s, "edit.undo", json!({}));
+            assert_eq!(s.doc, before);
+            run(&mut s, "edit.redo", json!({}));
+            assert_eq!(s.doc, after);
+            let saved = wordcraft_docx::read(&wordcraft_docx::write(&s.doc).unwrap()).unwrap();
+            let p = saved.para_at(&Pos::body(0, 0)).unwrap();
+            assert_eq!(p.props.numbering, expected.props.numbering);
+            assert_eq!(p.mark.size, expected.mark.size);
+            assert_eq!(p.props_of_char(6).italic, Some(true));
+        }
+    }
+}
